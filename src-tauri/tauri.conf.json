{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDmeow",
  "mainBinaryName": "MDmeow",
  "version": "1.7.8",
  "identifier": "com.zakee039.mdmeow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/gen-settings-example.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MDmeow",
        "width": 900,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "A minimalist WYSIWYG Markdown editor",
    "longDescription": "MDmeow is a minimalist, portable WYSIWYG Markdown editor with the Miku Cream rendering system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": {
          "en-US": {
            "localePath": "windows/locales/multilingual.wxl"
          }
        },
        "template": "windows/main.wxs",
        "fragmentPaths": [
          "windows/fragments/registry.wxs",
          "windows/fragments/multilingual-ui.wxs"
        ],
        "componentRefs": [
          "MDmeowInstallMarker",
          "MDmeowFileAssociations"
        ]
      }
    }
  }
}
